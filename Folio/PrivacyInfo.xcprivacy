<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App does not track users across apps or websites -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking domains -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Data types collected/used by this app -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  When the user chooses to use the AI Assistant feature, the text content
		  of the open PDF document is sent to the AI provider they configured
		  (OpenAI, Anthropic, or Groq). This is entirely user-initiated and
		  disclosed in the AI sidebar UI. No data is collected by the app developer.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Required reason APIs used by this app -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults is used to persist app preferences (appearance, zoom level,
		  AI provider selection, annotation colours, etc.) — all stored locally.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: Accessing info from the same app that wrote it -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
